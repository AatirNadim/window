{
  "name": "window",
  "version": "1.0.0",
  "description": "root package file for the window monorepo",
  "scripts": {
    "dev:landing": "pnpm --filter window-landing dev",
    "dev:frontend": "pnpm --filter window-ui dev",
    "dev:server": "pnpm --filter window-server dev",
    "build:landing": "pnpm --filter window-landing build",
    "build:shared": "pnpm --filter @window/shared build",
    "build:server": "pnpm --filter @window/shared build && pnpm --filter window-server build",
    "build:frontend": "pnpm --filter @window/shared build && pnpm --filter window-ui build",
    "start:landing": "pnpm --filter window-landing start",
    "start:server": "pnpm --filter window-server start",
    "start:frontend": "pnpm --filter window-ui start",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
